# Application
APP_NAME=ArchVision AI API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=archvision_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:replace_with_local_password@localhost:5432/archvision_ai

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=your_supported_model_name

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=ArchVision AI